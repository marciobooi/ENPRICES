{
  "name": "base-react-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "check:statement": "node scripts/check-statement.mjs",
    "preview": "vite preview",
    "check:share": "node scripts/check-share.mjs",
    "check:release": "npm run check:statement && npm run check:share"
  },
  "dependencies": {
    "@ecl/preset-eu": "^5.4.0",
    "axios": "^1.21.0",
    "driver.js": "^1.10.2",
    "html2canvas-pro": "^2.6.3",
    "i18next": "^26.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}
